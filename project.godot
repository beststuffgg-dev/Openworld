; Engine configuration file.
; Project Horizons — cross-platform voxel sandbox RPG.
; Godot 4.4+

config_version=5

[application]

config/name="Project Horizons"
config/description="A cross-platform voxel sandbox RPG. Vertical-slice foundation."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BlockDB="*res://src/world/BlockRegistry.gd"
GameState="*res://src/core/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.42, 0.62, 0.86, 1)

[input]

